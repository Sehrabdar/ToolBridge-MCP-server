# =============================================================================
# ToolBridge — Secure MCP Server for Authenticated Tool Execution
#
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# For local development with docker compose:
DATABASE_URL=postgresql+asyncpg://toolbridge:toolbridge@localhost:5433/toolbridge

# ---------------------------------------------------------------------------
# Future phases — DO NOT set these until the corresponding phase is implemented
# ---------------------------------------------------------------------------

# Phase 6 — GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Phase 6 — JWT
# JWT_SECRET=
